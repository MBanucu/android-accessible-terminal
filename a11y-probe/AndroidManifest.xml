<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mbanucu.a11yprobe"
    android:versionCode="1"
    android:versionName="1.0.0">

    <!-- The screen stream is a library this app depends on: the AAR published to
         Maven Central, which a11y-probe/build.sh fetches by version. Its own
         manifest declares these permissions and its two components, so a Gradle
         app gets them by merging; this build has no manifest merger, so they are
         declared here as well. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:label="A11y probe"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="A11y probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The service a screen reader would be. It is what reads a terminal's
             accessibility tree and performs actions on it; enabling it with
             `settings put secure enabled_accessibility_services` needs no root. -->
        <service
            android:name=".ProbeService"
            android:exported="true"
            android:label="A11y probe"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe" />
        </service>

        <!-- The library's consent activity: asks for the screen once, then hands
             it to the service below. Started from adb; this app's accessibility
             service accepts the system dialog itself. -->
        <activity
            android:name="io.github.mbanucu.screenstream.ScreenStreamActivity"
            android:exported="true"
            android:label="A11y probe stream" />

        <!-- Raw frames on 127.0.0.1:7100, for apps and for `adb forward`. -->
        <service
            android:name="io.github.mbanucu.screenstream.ScreenStream"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- The synchronous command surface: one call, one answer in the call.
             `content call` with method `dump` returns the tree instead of
             leaving the caller to poll a file. It is exported with no
             permission, the same boundary as the receiver: the accessibility
             service being enabled is the switch, and this is a test tool for a
             test device. -->
        <provider
            android:name=".ProbeProvider"
            android:authorities="io.github.mbanucu.a11yprobe.control"
            android:exported="true" />

        <!-- Commands arrive from adb: dump the tree, set text, focus, click, and
             report the probe's version. The second action is the
             io.github.mbanucu.samples.a11yprobe one from before this module was
             promoted; it is accepted for one release so an existing harness keeps
             working while it moves to the new name. -->
        <receiver
            android:name=".ProbeCommand"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.mbanucu.a11yprobe.COMMAND" />
                <action android:name="io.github.mbanucu.samples.a11yprobe.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
