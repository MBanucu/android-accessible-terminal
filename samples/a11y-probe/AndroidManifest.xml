<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mbanucu.samples.a11yprobe">

    <!-- The screen stream is a library this app depends on (the screenstream
         repository, compiled in as a source set by samples/build.sh). Its own
         manifest declares these permissions, so a Gradle app gets them from the
         AAR; here the sources are the dependency, so they are declared again. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:label="A11y probe"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="A11y probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The service a screen reader would be. It is what reads a terminal's
             accessibility tree and performs actions on it; enabling it with
             `settings put secure enabled_accessibility_services` needs no root. -->
        <service
            android:name=".ProbeService"
            android:exported="true"
            android:label="A11y probe"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe" />
        </service>

        <!-- The library's consent activity: asks for the screen once, then hands
             it to the service below. Started from adb; this app's accessibility
             service accepts the system dialog itself. -->
        <activity
            android:name="io.github.mbanucu.screenstream.ScreenStreamActivity"
            android:exported="true"
            android:label="A11y probe stream" />

        <!-- Raw frames on 127.0.0.1:7100, for apps and for `adb forward`. -->
        <service
            android:name="io.github.mbanucu.screenstream.ScreenStream"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Commands arrive from adb: dump the tree, set text, focus, click. -->
        <receiver
            android:name=".ProbeCommand"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.mbanucu.samples.a11yprobe.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
